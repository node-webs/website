<!-- ==========================================================================
   1. HTML 구조 (인풋창과 버튼을 한 박스에 깔끔하게 배치)
   ========================================================================== -->
<div class="search-container" id="custom-search-container">
    <!-- 입력창 -->
    <input type="text" id="search-input" placeholder="데이터를 불러오는 중입니다...">
    
    <!-- 🌟 인풋 내부 오른쪽 끝에 고정될 검색 버튼 -->
    <button type="button" id="custom-search-btn" class="search-btn">🔍</button>
    
    <!-- 자동완성 결과 리스트 -->
    <ul id="results-list" class="search-results"></ul>
</div>


<!-- ==========================================================================
   2. 일체형 검색창 CSS (Scoped Styles)
   ========================================================================== -->
<style>
    /* 전체 컨테이너를 상대 좌표의 기준점으로 설정 */
    .search-container {
        width: 100%;
        position: relative;
        display: block; 
    }

    .search-container input {
        width: 100%;
        padding: 0 60px 0 1.5rem; /* 🌟 중요: 오른쪽 패딩을 60px 주어 글자가 버튼과 겹치지 않게 함 */
        font-size: 1.1rem;
        border: 2px solid #ff9f43;
        border-radius: 30px; /* 완벽한 알약 모양 */
        box-sizing: border-box;
        outline: none;
        background-color: #f1f3f5;
        transition: all 0.2s ease;
    }

    /* 포커스 되었을 때 효과 */
    .search-container input:focus {
        border-color: #ff9f43;
        background-color: #ffffff;
        box-shadow: 0 2px 8px rgba(255, 159, 67, 0.15);
    }

    /* 🌟 인풋 창 내부 오른쪽 끝으로 버튼을 강제 고정 */
    .search-container .search-btn {
        position: absolute;
        right: 2px;         /* 테두리 두께를 감안해 미세하게 안쪽으로 배치 */
        top: 50%;
        transform: translateY(-50%); /* 위아래 정중앙 정렬 */
        
        width: 54px;         /* 인풋 창 내부 높이에 맞춰 정사각형 형태로 유연하게 대응 */
        background: transparent; /* 🌟 배경을 투명하게 하여 인풋 내부처럼 보이게 함 */
        border: none;
        color: #ff9f43;      /* 오렌지색 돋보기 아이콘 */
        font-size: 1.25rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.1s ease, color 0.2s ease;
        z-index: 10;         /* 인풋창보다 위에 오도록 설정 */
    }

    /* 버튼 마우스 호버 및 클릭 액션 */
    .search-container .search-btn:hover {
        color: #e68a2e;      /* 마우스 올리면 돋보기 색상 진하게 */
    }
    .search-container .search-btn:active {
        transform: translateY(-50%) scale(0.9); /* 누를 때 살짝 콩 튀는 효과 */
    }

    /* 자동완성 결과 리스트 스타일 (이제 100% 꽉 차게 떨어집니다) */
    .search-results {
        list-style: none;
        padding: 0;
        margin: 0;
        border: 1px solid #ddd;
        border-radius: 12px;
        background: white;

        /* 🌟 수정: 최대 높이를 200px에서 400px로 확장합니다. (8개까지 스크롤 없이 노출 가능) */
        max-height: 400px;  /* max-height: 200px; */
        overflow-y: auto;
        display: none; 
        position: absolute; 
        left: 0;
        width: 100%; /* 🌟 버튼이 안으로 들어갔으므로 검색창 너비와 100% 일치시킴 */
        z-index: 100;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    .search-results li {
        padding: 12px 20px;
        cursor: pointer;
        border-bottom: 1px solid #f1f3f5;
        font-size: 0.95rem;
        color: #495057;
        text-align: left; 
    }

    .search-results li:last-child {
        border-bottom: none;
    }

    .search-results li.selected, 
    .search-results li:hover {
        background-color: #fff5eb; 
        color: #ff9f43;
    }

    .badge {
        font-size: 11px;
        padding: 3px 9px;
        border-radius: 12px;
        float: right;
        color: white;
        font-weight: bold;
    }
    .badge.dog { background-color: #ff9f43; } 
    .badge.cat { background-color: #54a0ff; } 
</style>


<!-- ==========================================================================
   3. 컴포넌트 로직 (외부 높이 변수를 받아 버튼 크기 자동 세밀 튜닝)
   ========================================================================== -->
<script type="module">
    import { loadPetDatabase, filterPets, loadEventDatabase, filterEventsByType, filterEventsByKeyword } from '/script/js/loadSearchData.js';

    // Nunjucks 안전 변수 수신
    const configWidth = "{{ searchWidth | default('400px') }}";
    const configHeight = "{{ searchHeight | default('60px') }}";

    // DOM 요소 선택
    const container = document.getElementById('custom-search-container');
    const searchInput = document.getElementById('search-input');
    const searchBtn = document.getElementById('custom-search-btn');
    const resultsList = document.getElementById('results-list');

    // 화면 렌더링 시 동적 스타일 조립
    container.style.maxWidth = configWidth;
    container.style.margin = "0 auto";
    searchInput.style.height = configHeight;
    
    // 🌟 버튼 높이와 너비를 인풋창 높이보다 살짝 작게 만들어 내부에 쏙 들어가게 만듭니다.
    const btnSize = parseInt(configHeight) - 6;
    searchBtn.style.height = `${btnSize}px`;
    searchBtn.style.width = `${btnSize}px`;
    resultsList.style.top = `calc(${configHeight} + 8px)`;
    
    // 자동완성 팝업창 위치를 인풋 높이에 연동
    resultsList.style.top = `calc(${configHeight} + 8px)`;

    // --- 기존 검색 엔진 로직 고스란히 유지 ---
    let currentIndex = -1; 

    const highlightItem = (items) => {
        Array.from(items).forEach(item => item.classList.remove('selected'));
        if (currentIndex >= 0 && items[currentIndex]) {
            items[currentIndex].classList.add('selected');
            items[currentIndex].scrollIntoView({ block: 'nearest' });
        }
    };

    const selectItem = (name) => {
        alert("선택된 이름: " + name);
        searchInput.value = name;
        resultsList.style.display = 'none';
        currentIndex = -1;
    };

    const renderResults = (results, keyword) => {
        resultsList.innerHTML = '';
        currentIndex = -1;

        // 품종 검색 결과가 없고, 키워드로 검색된 이벤트도 없다면 종료하기 위한 사전 체크
        const directMatchedEvents = filterEventsByKeyword(keyword);
        // console.log("directMatchedEvents :: ", directMatchedEvents)

        // 품종 결과도 '없고' + 직접 찾은 이벤트도 '동시에 없을 때'만 "결과 없음"을 띄웁니다.
        if (results.length === 0 && directMatchedEvents.length === 0) {
            resultsList.innerHTML = `<li>검색 결과가 없습니다 🐾</li>`;
            resultsList.style.display = 'block';
            return;
        }

        // 1. 매칭된 품종들 그리기
        // [Step 1] 매칭된 품종들 먼저 리스트에 추가
        results.forEach(pet => {
            const li = document.createElement('li');
            const typeKorean = pet.type === 'dog' ? '강아지' : '고양이';
            
            li.innerHTML = `
                <strong>${pet.name.ko}</strong> 
                <span style="color: #888; font-size: 14px;">(${pet.name.en})</span>
                <span class="badge ${pet.type}">${typeKorean}</span>
            `;
            
            li.dataset.nameKo = pet.name.ko;
            li.addEventListener('click', () => selectItem(pet.name.ko));
            resultsList.appendChild(li);
        });

        // [Step 2] 이벤트 수집 및 통합 (중복 방지)
        // 2-1. 품종 연동형 이벤트 추출
        // 검색된 품종들의 타입 추출 (예: ['dog', 'cat'])
        const detectedTypes = [...new Set(results.map(pet => pet.type))];
        const typeEvents = filterEventsByType(detectedTypes);

        // 2-2. 품종 연동 이벤트와 제목 키워드 매칭 이벤트를 하나로 합치고 중복 제거 (id 기준)
        const allMatchedEvents = [...typeEvents, ...directMatchedEvents];
        const uniqueEvents = allMatchedEvents.filter((ev, index, self) =>
            index === self.findIndex((t) => t.id === ev.id)
        );

        // [Step 3] 통합된 이벤트가 존재한다면 구분선 밑에 출력
        // [Step 3] uniqueEvents에 ev_19가 잡혀있으므로 이 안으로 진입함!
        if (uniqueEvents.length > 0) {
            // 🧡 구분선(밑줄) 추가
            const divider = document.createElement('li');
            divider.style.padding = "0";
            divider.style.borderBottom = "1px dashed #ff9f43"; 
            divider.style.margin = "6px 0";
            divider.style.cursor = "default";
            divider.addEventListener('click', (e) => e.stopPropagation()); 
            resultsList.appendChild(divider);

            // 💚 이벤트 리스트 그리기
            uniqueEvents.forEach(event => {
                const liEvent = document.createElement('li');
                liEvent.style.backgroundColor = "#fdfbf7"; 
                liEvent.innerHTML = `
                    <span style="color: #e68a2e; font-weight: bold; font-size: 12px; margin-right: 6px;">[${event.badge}]</span>
                    <span style="font-size: 13px; color: #495057;">${event.title}</span>
                `;
                
                liEvent.addEventListener('click', (e) => {
                    e.stopPropagation(); 
                    location.href = event.link;
                });
                
                resultsList.appendChild(liEvent);
            });
        }

        // 🌟 마지막 점검: 이 코드가 정상적으로 실행되어 display가 block으로 켜져야 합니다!
        resultsList.style.display = 'block';
    };

    // 🌟 실시간 입력 핸들러 부분도 keyword를 넘겨주도록 미세 수정
    const handleSearch = (event) => {
        const keyword = event.target.value.trim();
        const filteredResults = filterPets(keyword); 
        
        // 품종 결과도 없고 키워드도 완전히 공백이면 창 닫기
        // if (filteredResults.length === 0 && !keyword.trim()) {
        //     resultsList.innerHTML = '';
        //     resultsList.style.display = 'none';
        //     currentIndex = -1;
        //     return;
        // }

        // 🌟 수정: 입력창이 완전히 텅 비었을 때만 결과창을 닫고 초기화합니다.
        if (keyword === "") {
            resultsList.innerHTML = '';
            resultsList.style.display = 'none';
            currentIndex = -1;
            return;
        }
        
        // 글자가 조금이라도 들어있다면 무조건 그리기 엔진으로 보냅니다.
        renderResults(filteredResults, keyword);
    };

    searchInput.addEventListener('keydown', (e) => {
        const items = resultsList.getElementsByTagName('li');
        
        if (resultsList.style.display !== 'none' && items.length > 0 && !items[0].textContent.includes('검색 결과가 없습니다')) {
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                currentIndex++;
                if (currentIndex >= items.length) currentIndex = 0;
                highlightItem(items);
                return;
            } 
            else if (e.key === 'ArrowUp') {
                e.preventDefault();
                currentIndex--;
                if (currentIndex < 0) currentIndex = items.length - 1;
                highlightItem(items);
                return;
            }
        }

        if (e.key === 'Enter') {
            e.preventDefault();
            if (currentIndex >= 0 && items[currentIndex]) {
                const selectedName = items[currentIndex].dataset.nameKo;
                if (selectedName) {
                    selectItem(selectedName);
                }
            } 
            else {
                const currentInputValue = searchInput.value.trim();
                if (currentInputValue) {
                    selectItem(currentInputValue);
                }
            }
        }
    });

    searchInput.addEventListener('input', handleSearch);
    searchInput.disabled = true;
    searchInput.placeholder = "데이터를 불러오는 중입니다...";

    document.addEventListener('click', (e) => {
        if (!e.target.closest('.search-container')) {
            resultsList.style.display = 'none';
        }
    });

    // 🌟 데이터 로드부도 깔끔하게 일원화됩니다.
    Promise.all([
        loadPetDatabase(searchInput),
        loadEventDatabase()
    ]);
</script>