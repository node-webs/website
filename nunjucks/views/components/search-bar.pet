<!-- ==========================================================================
   1. HTML 구조 (Template)
   ========================================================================== -->
<div class="search-container">
    <input type="text" id="search-input" placeholder="데이터를 불러오는 중입니다...">
    <ul id="results-list" class="search-results"></ul>
</div>


<!-- ==========================================================================
   2. 컴포넌트 전용 스타일 (Scoped Styles)
   ========================================================================== -->
<style>
    .search-container {
        width: 100%;
        position: relative;
    }

    /* .search-container input {
        width: 100%;
        padding: 12px 20px;
        border: 2px solid #e0e0e0;
        border-radius: 25px;
        font-size: 15px;
        box-sizing: border-box;
        outline: none;
        background-color: #f1f3f5;
        transition: all 0.2s ease;
    } */

    .search-container input {
        /* 1. 너비: 기존 max-width(예: 500px)가 있었다면 100px 줄인 값으로 설정 */
        width: 100%;
        max-width: 400px; /* 500px -> 400px로 100px 축소 */

        /* 2. 높이: 기존 padding이나 height에 20px을 추가 */
        /* 만약 height로 고정되어 있었다면 (예: height: 40px -> 60px) */
        height: 60px; 

        /* 또는 padding으로 높이를 조절하고 계셨다면 아래와 같이 늘려줍니다. */
        /* padding: 1.2rem 1.5rem; */

        /* --- 이하 기존 디자인 스타일 유지 --- */
        padding: 0 1.5rem;
        font-size: 1.1rem;
        border: 2px solid #ff9f43;
        border-radius: 30px; /* 높이가 늘어남에 따라 알약 모양을 유지하도록 조절 */
        outline: none;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

    /* 포커스 되었을 때 부드러운 오렌지 계열로 변경 */
    .search-container input:focus {
        border-color: #ff9f43;
        background-color: #ffffff;
        box-shadow: 0 2px 8px rgba(255, 159, 67, 0.15);
    }

    /* 자동완성 결과 리스트 스타일 */
    .search-results {
        list-style: none;
        padding: 0;
        margin: 8px 0 0 0;
        border: 1px solid #ddd;
        border-radius: 12px;
        background: white;
        max-height: 200px;
        overflow-y: auto;
        display: none; 
        position: absolute; 
        width: 100%;
        z-index: 100;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    .search-results li {
        padding: 12px 20px;
        cursor: pointer;
        border-bottom: 1px solid #f1f3f5;
        font-size: 0.95rem;
        color: #495057;
        text-align: left; /* 왼쪽 정렬 보장 */
    }

    .search-results li:last-child {
        border-bottom: none;
    }

    .search-results li.selected, 
    .search-results li:hover {
        background-color: #fff5eb; 
        color: #ff9f43;
    }

    /* 강아지/고양이 배지 스타일 */
    .badge {
        font-size: 11px;
        padding: 3px 9px;
        border-radius: 12px;
        float: right;
        color: white;
        font-weight: bold;
    }
    .badge.dog { background-color: #ff9f43; } 
    .badge.cat { background-color: #54a0ff; } 
</style>


<!-- ==========================================================================
   3. 컴포넌트 로직 (Script Module)
   ========================================================================== -->
<script type="module">
    // 💡 상대 경로 조절: 컴포넌트가 어디서 include 되든 브라우저 기준 절대 경로(/js/...)로 모듈을 가져옵니다.
    import { loadPetDatabase, filterPets } from '/script/js/loadSearchData.js';

    // 화면 요소(DOM) 가져오기
    const searchInput = document.getElementById('search-input');
    const resultsList = document.getElementById('results-list');

    let currentIndex = -1; // 키보드 선택 번호표

    // 1. 하이라이트 효과 전담 함수
    const highlightItem = (items) => {
        Array.from(items).forEach(item => item.classList.remove('selected'));
        if (currentIndex >= 0 && items[currentIndex]) {
            items[currentIndex].classList.add('selected');
            items[currentIndex].scrollIntoView({ block: 'nearest' });
        }
    };

    // 2. 최종 선택 완료 시 실행되는 함수
    const selectItem = (name) => {
        alert("선택된 이름: " + name);
        searchInput.value = name;
        resultsList.style.display = 'none';
        currentIndex = -1;
    };

    // 3. 필터링된 결과를 화면에 HTML 줄로 그려주는 함수
    const renderResults = (results) => {
        resultsList.innerHTML = '';
        currentIndex = -1; 

        if (results.length === 0) {
            resultsList.innerHTML = `<li>검색 결과가 없습니다 🐾</li>`;
            resultsList.style.display = 'block';
            return;
        }

        results.forEach(pet => {
            const li = document.createElement('li');
            const typeKorean = pet.type === 'dog' ? '강아지' : '고양이';
            
            li.innerHTML = `
                <strong>${pet.name.ko}</strong> 
                <span style="color: #888; font-size: 14px;">(${pet.name.en})</span>
                <span class="badge ${pet.type}">${typeKorean}</span>
            `;
            
            // 키보드로 선택했을 때 값을 쉽게 가져올 수 있도록 데이터 매핑
            li.dataset.nameKo = pet.name.ko;

            // 클릭 이벤트 설정
            li.addEventListener('click', () => selectItem(pet.name.ko));
            resultsList.appendChild(li);
        });

        resultsList.style.display = 'block';
    };

    // 4. 실시간 입력 감지 이벤트 핸들러
    const handleSearch = (event) => {
        const keyword = event.target.value;
        const filteredResults = filterPets(keyword); 
        
        if (filteredResults.length === 0 && !keyword.trim()) {
            resultsList.innerHTML = '';
            resultsList.style.display = 'none';
            currentIndex = -1;
            return;
        }
        
        renderResults(filteredResults);
    };

    // 5. 키보드 방향키 및 엔터 조작 이벤트
    searchInput.addEventListener('keydown', (e) => {
        const items = resultsList.getElementsByTagName('li');
        
        // 방향키 조작 (결과창이 열려있을 때만)
        if (resultsList.style.display !== 'none' && items.length > 0 && !items[0].textContent.includes('검색 결과가 없습니다')) {
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                currentIndex++;
                if (currentIndex >= items.length) currentIndex = 0;
                highlightItem(items);
                return;
            } 
            else if (e.key === 'ArrowUp') {
                e.preventDefault();
                currentIndex--;
                if (currentIndex < 0) currentIndex = items.length - 1;
                highlightItem(items);
                return;
            }
        }

        // 엔터 키 조작
        if (e.key === 'Enter') {
            e.preventDefault();
            // 1️⃣ 방향키로 리스트의 항목을 선택한 상태라면
            if (currentIndex >= 0 && items[currentIndex]) {
                const selectedName = items[currentIndex].dataset.nameKo;
                if (selectedName) {
                    selectItem(selectedName);
                }
            } 
            // 2️⃣ 방향키를 누르지 않고 검색창에서 바로 엔터를 쳤다면
            else {
                const currentInputValue = searchInput.value.trim();
                if (currentInputValue) {
                    selectItem(currentInputValue);
                }
            }
        }
    });

    // 6. 초기 실행 설정
    searchInput.addEventListener('input', handleSearch);
    searchInput.disabled = true;
    searchInput.placeholder = "데이터를 불러오는 중입니다...";

    // 바탕화면 클릭 시 결과창 닫기
    document.addEventListener('click', (e) => {
        if (!e.target.closest('.search-container')) {
            resultsList.style.display = 'none';
        }
    });

    // DB 로드 시작
    loadPetDatabase(searchInput);
</script>